# ─────────────────────────────────────────────────────────────
# THE DESK — bot configuration
# Copy this file to `.env` and fill in the values.
# NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

# Bot token — Discord Developer Portal > Your App > Bot > Reset Token
DISCORD_TOKEN=

# Application (client) ID — Developer Portal > Your App > General Information
CLIENT_ID=

# The guild (server) ID of THE DESK.
# Enable Developer Mode in Discord, right-click the server > Copy Server ID.
GUILD_ID=

# ── Optional ────────────────────────────────────────────────

# trace | debug | info | warn | error   (default: info)
LOG_LEVEL=info

# Register slash commands to GUILD_ID automatically on startup. (default: true)
AUTO_DEPLOY_COMMANDS=true

# Mirror bot logs into the #bot-logs channel. (default: true)
DISCORD_LOGGING=true

# Where resolved resource IDs are persisted. (default: data/state.json)
STATE_FILE=data/state.json

# development | production   (default: development)
NODE_ENV=development

# Bind a small HTTP health endpoint on this port.
# ONLY needed on hosts that kill a process which does not listen on a port
# (Render web services, Koyeb, some free panels). Leave empty otherwise —
# a Discord bot needs no inbound connection.
HEALTH_PORT=
